{
  "name": "Notater Skriver",
  "short_name": "Notater",
  "description": "Dokumenteditor",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#eef1f8",
  "theme_color": "#27408b",
  "orientation": "any",
  "icons": [
    {
      "src": "./pictures/Logo_Notater.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./pictures/Logo_Notater.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Notater Skriver Dokument",
      "accept": {
        "application/x-notater": [
          ".nts"
        ]
      }
    }
  ]
}